{
  "name": "worker",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD_KV",
      "id": "cbf8835c79da449fa3fb044acae5b1b6"
    }
  ]
}
  // 👇 新增以下兩段（支援 Cloudflare 免費版 1v1 房間連線）
  "durable_objects": {
    "bindings": [
      {
        "name": "WATERPOLO_ROOM",
        "class_name": "WaterPoloRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WaterPoloRoom"]
    }
  ]
}
